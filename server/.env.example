APP_NAME=kosmos-hub
APP_ENV=development
APP_SECRET_KEY=replace-with-a-long-random-secret
AUTO_CREATE_TABLES=true
AUTO_VERIFY_DOMAINS=kosmos-medien.de
DATABASE_URL=mysql+pymysql://kosmos_hub_app:replace-me@127.0.0.1:3306/kosmos_hub
PUBLIC_BASE_URL=https://kosmos-hub.example.com
WORDPRESS_BRIDGE_MIN_VERSION=0.1.0
# Optional: Set both values to protect Hub pages and internal APIs with Basic Auth.
HUB_ACCESS_USERNAME=
HUB_ACCESS_PASSWORD=
